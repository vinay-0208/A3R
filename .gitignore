*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.opendb
*.VC.db

# Unity Autogenerated Files & Diagnostic Logs
unity_project/all_code.txt
unity_project/all_docs.txt
unity_project/all_evals.txt
unity_project/final_report.txt
unity_project/full_log*.txt
unity_project/logcat*.txt
