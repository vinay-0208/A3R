unity_project/crop.py
unity_project/extract.py
unity_project/patch.cs
unity_project/patch.py
unity_project/temp_ui.cs
build_ui_final.log
*.log

# OS Generated
.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# Android / Gradle / Build artifacts
*.apk
*.aab
*.app
*.unitypackage
.gradle/
local.properties

# Python virtual environment & cache
.venv/
venv/
ENV/
env/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# Internal evaluation scratch, device dumps & presentation files
Tests/
research_audit/
pdf_extracted_images/
A3R_Final_Project_Review.pptx
